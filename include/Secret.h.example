/**
 * @file Secret.h
 * @brief Dane dostepowe WiFi i punktu dostepowego (nie trafiaja do repozytorium).
 */
#pragma once

// Skopiuj ten plik jako include/Secret.h i wpisz swoje dane WiFi.
// Secret.h jest w .gitignore - nie trafi do repozytorium.

/// Nazwa sieci WiFi; pusta = od razu punkt dostepowy.
#define WIFI_SSID     "TwojaSiec"
/// Haslo sieci WiFi; puste = siec otwarta.
#define WIFI_PASSWORD "TwojeHaslo"  // puste "" = siec otwarta

// Nazwa w sieci: http://lcdtester.local
/// Nazwa ESP w sieci (mDNS), strona pod http://<nazwa>.local.
#define WIFI_HOSTNAME "lcdtester"

// Gdy nie uda sie polaczyc z WiFi, ESP startuje wlasny punkt dostepowy
/// Nazwa zapasowego punktu dostepowego.
#define AP_SSID       "LcdTester"
/// Haslo punktu dostepowego; puste = bez hasla, inaczej min. 8 znakow.
#define AP_PASSWORD   "lcdtester123"   // puste "" = AP bez hasla, inaczej min. 8 znakow
